mapscripts HollowHill_MapScripts {}

script HollowHill_EventScript_ToMirroh16 {
    setvar(VAR_TEMP_1, 1)          # (else the trigger fires again every frame of the fade)
    warp(MAP_MIRROH_GATE, 28, 21)
}

