raw`
    .set LOCALID_DRL_CADMUS,     1
    .set LOCALID_DRL_BALL_FRIG,  2
    .set LOCALID_DRL_BALL_TEDD,  3
    .set LOCALID_DRL_BALL_TINK,  4
    .set LOCALID_DRL_EDEN,       5
    .set LOCALID_DRL_NEPTUNE,    6
    .set LOCALID_DRL_PILFER,     7
`

// ================= DREAMSTONE RUINATION - Chapter 1, Beat 2 & 3 =================
// Lab briefing -> three-starter selection -> Eden's theft and fight -> (monastery cell) ->
// shard briefing back here.
// VAR_UNUSED_0x40A1 = lab stage: 0 fresh, 1 briefed/choosing, 2 theft done (cell scene next),
//                     3 back from the cell (shard briefing), 4 done
// VAR_UNUSED_0x4083 = starter picked (1 Frigibax, 2 Teddiursa, 3 Tinkatink)
// Dialogue: the user's own revision (2026-11-16), with agreed typo and lore fixes.
// Cadmus warm, formal and in command. Osrid is 20: guarded, but hot-blooded when pushed.
// Eden is 17, a decoy sent in over her head: defiant on the surface, skittish underneath.
// Osrid's nameplate: "Prince <name>" in private with Cadmus, "Nomad Alban" when anyone else
// is present. Eden is "Brigand ???" / "Thief" until she gives her name in the cell.

mapscripts PellucaUmbraLab_MapScripts{
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_UNUSED_0x886)
        setflag(FLAG_UNUSED_0x887)
        setflag(FLAG_UNUSED_0x88E)
        // the three balls are already on the table when Osrid walks in ("Those balls behind
        // you...") and stay there until he has chosen
        if (var(VAR_UNUSED_0x40A1) <= 1){
            clearflag(FLAG_UNUSED_0x885)
        } else {
            setflag(FLAG_UNUSED_0x885)
        }
        if (var(VAR_UNUSED_0x40A1) == 1){
            setobjectxyperm(LOCALID_DRL_CADMUS, 5, 8)
            setobjectmovementtype(LOCALID_DRL_CADMUS, MOVEMENT_TYPE_FACE_UP)
        }
        return
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_UNUSED_0x40A1, 0: DR_Lab_Briefing
        VAR_UNUSED_0x40A1, 3: DR_Lab_ShardBriefing
    ]
}

script DR_Lab_Briefing{
    lockall
    setvar(VAR_UNUSED_0x40A1, 1)
    delay(20)
    // Elderflower study (2026-11-16): enter at the mat (4,9); Cadmus waits in front of the long
    // table with the three balls behind him.
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up walk_right * 5 face_up))
    waitmovement(0)
    applymovement(LOCALID_DRL_CADMUS, moves(face_down))
    waitmovement(0)
    delay(20)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Welcome home, my Prince. Forgive the clutter.\pHere, at least, we can speak freely."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Will you let me see your face?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("...No. Not yet."))
    closemessage
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Then I will not ask again."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("It is good to have you home.\pThe last time you were in Pelluca, you and your sister were ten years old. You fell out of the Academy's apple tree in front of half the faculty. Do you remember?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("I remember the tree. Rhydia wouldn't stop laughing."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("How I miss those days..."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("But let us return to the present.\pTo the public, you are Nomad Alban: a Rainhawk, a war hero of the Sevii campaign, and now head of security for the Ministry of Education.\pThe post will let you travel freely throughout the Empire, and few will interrogate you. If anyone questions your authority, they are questioning MY authority as Vizier of Education. Use it well."))
    msgbox(format("Moving on. You will live among the Academy's students, as your new post requires. The dormitory northwest of here has a room with your cover name on the door, the largest on the first floor. It isn't much, but the door locks and the bed is soft."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("That's all well and good. But why did it take ten years to bring me home? After Father's assassination, I thought-"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Because there was too much back then I didn't know... only that you were the next target.\pHiding you from your father's assassins required drastic measures. A new identity, a Nomad discarded by the Albans... it was the perfect smokescreen.\pI meant for you to wait out the danger at a military academy overseas, among the children of minor nobles and soldiers. From there, a quiet commission, or better yet a place in the reserves, where I could keep watch over you and recall you formally when the time was right.\pFive years ago, our territorial dispute with Kanto escalated, and you were sent to the front lines. I lost track of you completely until very recently, I am ashamed to admit.\pBut now... I have a much clearer idea of what is happening in Cormoria, and of those I believe brought about Eldred's demise.\pThe time was right to bring you home, though I wish to Arceus it were under better circumstances. But... you are here now, and stronger than I could have ever hoped. Your father would be proud."))
    msgbox(format("You have two missions. The first is the one the whole Empire will see.\pA Rainhawk who clears every Trial has the right to challenge the Champion. She is someone you know quite well... someone who loves you even more than I do."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("My sister, huh. She got her starter right before you sent me away, if I recall."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Your sister. Rhydia has held the Champion title for five years now, and she rules the Empire in your mother's name besides.\pShe is one of the most talented Trainers we have seen in generations, but our enemies are closing in... I believe her power will not be enough to save Cormoria.\pKeerin never chose her, my Prince.\pA man who beats the Champion in front of the whole Empire can tell everyone who he really is, and no one will dare touch him."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Does Rhydia know I'm here? What about my mother?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("No. Neither of them has heard a word of you in ten years. I could not risk even that much."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("...So it's true. They think I'm dead."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Your sister refuses to believe it. She still sends candles to your shrine every spring, on the birthday you share."))
    msgbox(format("Your mother... stopped sending hers some time ago."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("......"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("When the time is right, they will know. You have my word."))
    closemessage
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("One more thing, and it matters more than the rest.\pMy Prince... what are Pokémon to you?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("...Tools. You keep them fed, you keep them sharp, and you use them carefully to control outcomes upon the battlefield."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Those sound like Surge's words."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("They kept me alive."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Certainly they did... but they also left you burning on that beach."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Enough debate.\pThose balls behind you... are those starter Pokémon? I thought those were only given to noble children."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Usually. These three are different, and all are one of a kind.\pOne of them shall be your first step toward becoming who you were always meant to be."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Strange, choosing a partner of my own at twenty. If things had been different, I'd have had one before I was sent away..."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("We cannot change the past, my Prince, but perhaps there is a silver lining...\pIn any case, read the note beside each one before you choose. I wrote them myself, so forgive the handwriting."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("I will."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Also, before you choose, please take this.\pYou'll be meeting a great many Pokémon from here on, and you should keep a record of them. I will explain in greater detail later."))
    hideportrait
    closemessage
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("{PLAYER} received the PokéLog!"))
    waitfanfare
    setflag(FLAG_SYS_POKEDEX_GET)
    closemessage
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Every new Trainer is given one. It isn't elaborate, but it will serve us well.\pWrite down each one you meet, what it is and how it fights, in your own hand. It also holds the latest map of the region, just before the index."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Thank you. I will choose now."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Proceed, my Prince. This is an important choice."))
    hideportrait
    closemessage
    // he steps aside to stand by the door, leaving the table and the rug clear
    applymovement(LOCALID_DRL_CADMUS, moves(walk_left * 4 walk_down face_up))
    waitmovement(0)
    releaseall
    end
}

script DR_Lab_BallFrigibax{
    lock
    faceplayer
    showmonpicshiny(SPECIES_FRIGIBAX, 10, 3)
    msgbox(format("Heraldic Frigibax.\pI hatched this one from an egg I found on Mt. Mirroh. Note its coloring. In all my years I have never seen another like it.\pIt favors Dragon and Ice moves, though it will learn a great deal more if you are patient with it.\pIts final form, Baxcalibur, is so rare that only one other has been recorded on this continent in two hundred years.\pOne old text claims it can grow stronger still with the help of a special stone. I have yet to find any proof that confirms this, however."))
    hidemonpic
    msgbox(format("Take the Heraldic Frigibax as your partner?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_UNUSED_0x4083, 1)
        givemon(SPECIES_FRIGIBAX, 5, item=ITEM_SITRUS_BERRY, isShiny=TRUE)
        removeobject(LOCALID_DRL_BALL_FRIG)
        closemessage
        goto(DR_Lab_Theft)
    }
    release
    end
}

script DR_Lab_BallTeddiursa{
    lock
    faceplayer
    showmonpic(SPECIES_TEDDIURSA, 10, 3)
    msgbox(format("Bloodmoon Teddiursa.\pWhispers of a Blood Moon line have circulated for over a century. I found this cub by pure chance a year ago, on a small wooded island far to the east.\pMuch about it is still a mystery. What I have seen so far suggests a gift for special attacks and a sturdy constitution, and its moves seem to grow along the same lines."))
    hidemonpic
    msgbox(format("Take the Bloodmoon Teddiursa as your partner?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_UNUSED_0x4083, 2)
        givemon(SPECIES_TEDDIURSA, 5, item=ITEM_SITRUS_BERRY)
        removeobject(LOCALID_DRL_BALL_TEDD)
        closemessage
        goto(DR_Lab_Theft)
    }
    release
    end
}

script DR_Lab_BallTinkatink{
    lock
    faceplayer
    showmonpic(SPECIES_TINKATINK, 10, 3)
    msgbox(format("Dragonmaul Tinkatink.\pI came across this egg in the dunes north of Mt. Ceram a few months ago, and I still can scarcely believe my luck.\pThe Tinkatink clans of Cormoria's deserts are said to share this coloring, and to learn moves suited to hunting dragons, and even other Fairy types.\pA colleague tells me these clans can grow stronger still with some rare material worked into their gear. I have not been able to confirm it."))
    hidemonpic
    msgbox(format("Take the Dragonmaul Tinkatink as your partner?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_UNUSED_0x4083, 3)
        givemon(SPECIES_TINKATINK, 5, item=ITEM_SITRUS_BERRY)
        removeobject(LOCALID_DRL_BALL_TINK)
        closemessage
        goto(DR_Lab_Theft)
    }
    release
    end
}

script DR_Lab_Theft{
    lockall
    additem(ITEM_POTION, 1)
    setvar(VAR_UNUSED_0x40A1, 2)
    setflag(FLAG_SYS_POKEMON_GET)
    delay(20)
    fadeoutbgm(4)
    fadescreen(FADE_TO_BLACK)
    delay(45)
    setobjectxy(OBJ_EVENT_ID_PLAYER, 9, 8)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
    setobjectxy(LOCALID_DRL_CADMUS, 5, 8)
    turnobject(LOCALID_DRL_CADMUS, DIR_NORTH)
    clearflag(FLAG_UNUSED_0x886)
    addobject(LOCALID_DRL_EDEN)
    if (var(VAR_UNUSED_0x4083) == 1){ removeobject(LOCALID_DRL_BALL_TINK) }
    if (var(VAR_UNUSED_0x4083) == 2){ removeobject(LOCALID_DRL_BALL_FRIG) }
    if (var(VAR_UNUSED_0x4083) == 3){ removeobject(LOCALID_DRL_BALL_TEDD) }
    delay(45)
    fadescreen(FADE_FROM_BLACK)
    playbgm(MUS_ENCOUNTER_AQUA, FALSE)
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("...The lamps just went out. It seems we have an uninvited guest."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Don't mind me, gentlemen. This won't take long."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("There is nowhere for you to go, little thief."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Mmm... I have my ways."))
    hideportrait
    closemessage
    // she glances at the way out, then goes for it
    applymovement(LOCALID_DRL_EDEN, moves(face_left delay_16 face_down delay_16 face_left))
    waitmovement(0)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("But I have what I need now, so I'll just-"))
    hideportrait
    closemessage
    applymovement(LOCALID_DRL_EDEN, moves(walk_fast_left * 6))
    waitmovement(0)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Neptune. Bar the door, and keep one eye on the window. If she runs, pin her. Gently."))
    hideportrait
    closemessage
    // Neptune comes out beside Cadmus and plants himself on the doorway (4,9) before she can reach it
    clearflag(FLAG_UNUSED_0x887)
    addobject(LOCALID_DRL_NEPTUNE)
    playmoncry(SPECIES_JOUSTEEL, CRY_MODE_NORMAL)
    applymovement(LOCALID_DRL_NEPTUNE, moves(walk_fast_down walk_fast_right face_up))
    waitmovement(0)
    waitmoncry
    // cut off from the door, she looks to her right, toward the window on the west wall (user)
    applymovement(LOCALID_DRL_EDEN, moves(face_left emote_exclamation_mark))
    waitmovement(0)
    delay(16)
    applymovement(LOCALID_DRL_EDEN, moves(lock_facing_direction walk_up unlock_facing_direction))
    waitmovement(0)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("...Nobody said anything about a Jousteel..."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("...But it doesn't matter. Lay a hand on me and you'll have a lot of explaining to do, Vizier. Bigger people than you want this delivered."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Bigger people, you say? No person stands above my authority except the Empress, child."))
    msgbox(format("Unless... hmm. Could this be...?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("How kind of THEM to drop a lead right into my lap."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("......"))
    msgbox(format("I... I work alone, Vizier."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Of course you do. I'm looking forward to hearing ALL about it."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Rainhawk, our guest seems eager to test herself. Would you oblige her? Consider it your first lesson with your new partner. Neptune and I will mind the door."))
    hideportrait
    closemessage
    // the face-off happens on the rug in the middle of the room
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_fast_left * 3 walk_fast_up walk_fast_left walk_fast_up face_up))
    applymovement(LOCALID_DRL_EDEN, moves(face_down))
    waitmovement(0)
    delay(12)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("...And nobody said anything about a soldier, either."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Who might you be? Is that a mending mask? From Athanto? That's worth more than this whole lab."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("“Nomad”")
    msgbox(format("Put the ball back and surrender quietly."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("If you want it so badly, come and take it. Pilfer, up!"))
    hideportrait
    closemessage
    clearflag(FLAG_UNUSED_0x88E)
    addobject(LOCALID_DRL_PILFER)
    applymovement(LOCALID_DRL_PILFER, moves(face_down))
    waitmovement(0)
    playmoncry(SPECIES_NICKIT, CRY_MODE_NORMAL)
    waitmoncry
    delay(20)
    // A story battle: losing does not white out; the scene carries on with its own lines.
    setflag(FLAG_DR_STORY_BATTLE)
    if (var(VAR_UNUSED_0x4083) == 1){ trainerbattle_no_intro(TRAINER_DR_EDEN_LAB_1, DR_Lab_Text_EdenDefeat) }
    if (var(VAR_UNUSED_0x4083) == 2){ trainerbattle_no_intro(TRAINER_DR_EDEN_LAB_2, DR_Lab_Text_EdenDefeat) }
    if (var(VAR_UNUSED_0x4083) == 3){ trainerbattle_no_intro(TRAINER_DR_EDEN_LAB_3, DR_Lab_Text_EdenDefeat) }
    clearflag(FLAG_DR_STORY_BATTLE)
    lockall
    delay(20)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_LOST) {
        goto(DR_Lab_EdenWins)
    }
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("How did you crush me so easily? I even picked the starter that was strong against yours!\pWho are you? No... WHAT are you?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("“Nomad”")
    msgbox(format("Nomad Alban. I'm the youngest Rainhawk in history."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("Never heard of you!"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("“Nomad”")
    msgbox(format("That's fine. I've never heard of you either."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Hah... you've got a sharp tongue on you, Nomad. Just know that people like me don't stay in cells for long.\pAnd when I'm out, I want a rematch... with relish."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("A rematch that will never happen. The Templars keep their holes very deep, and very dark. And they are not known for their mercy.\pNeptune, our guest is leaving. Escort her."))
    goto(DR_Lab_TheftEnd)
}

// If Osrid loses (user, 2026-11-17): Eden gloats, runs for the window, and Neptune pins her.
script DR_Lab_EdenWins{
    setflag(FLAG_DR_LOST_TO_EDEN_LAB)
    special(HealPlayerParty)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Hah! That's it? Some soldier you are."))
    msgbox(format("Who are you, anyway?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("“Nomad”")
    msgbox(format("...Nomad Alban. I'm the youngest Rainhawk in history."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("The youngest Rainhawk in history, and you lost to me? Wait until the others hear about this."))
    msgbox(format("Well, it's been fun, gentlemen, but I really must be going."))
    hideportrait
    closemessage
    applymovement(LOCALID_DRL_EDEN, moves(walk_fast_up walk_fast_left * 3))
    waitmovement(0)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Neptune. Pin her. Gently."))
    hideportrait
    closemessage
    playmoncry(SPECIES_JOUSTEEL, CRY_MODE_NORMAL)
    applymovement(LOCALID_DRL_NEPTUNE, moves(walk_fast_left walk_fast_up * 5 walk_fast_left * 2 walk_fast_up face_right))
    waitmovement(0)
    waitmoncry
    applymovement(LOCALID_DRL_EDEN, moves(face_left emote_exclamation_mark))
    waitmovement(0)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("Ow! Hey! Get this walking suit of armor off me!"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Do not look so grim, Rainhawk. Every Trainer loses a first real battle. The good ones remember why."))
    msgbox(format("As for you, child... the Templars keep their holes very deep, and very dark. And they are not known for their mercy.\pNeptune, our guest is leaving. Escort her."))
    goto(DR_Lab_TheftEnd)
}

script DR_Lab_TheftEnd{
    hideportrait
    closemessage
    playmoncry(SPECIES_JOUSTEEL, CRY_MODE_NORMAL)
    waitmoncry
    delay(30)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_UNUSED_0x885)
    setflag(FLAG_UNUSED_0x886)
    setflag(FLAG_UNUSED_0x887)
    setflag(FLAG_UNUSED_0x88E)
    warp(MAP_PELLUCA_TEMPLAR_MONASTERY, 6, 6)
    waitstate
    releaseall
    end
}

text DR_Lab_Text_EdenDefeat{
    format("Wh-what? You've had that Pokémon for less than two minutes!")
}

// Back from the monastery cell (stage 3): Umbra's shard briefing, his "other mission".
// Cadmus speaks at his own level of knowledge (the fairy-tale history, the operational plan)
// and does not name his source (Nemo) or the stone-mender (Roma).
script DR_Lab_ShardBriefing{
    lockall
    setvar(VAR_UNUSED_0x40A1, 4)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up face_up))
    applymovement(LOCALID_DRL_CADMUS, moves(face_down))
    waitmovement(0)
    delay(20)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("That girl knew exactly where to look, and exactly what to take. Someone knows more about this place than they should.\pBut just how could that be..."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Someone who knew I was coming?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Or someone who knew I was preparing for someone. Either way... I can no longer put off telling you about your... other mission. And this one is even more important than the Trials."))
    msgbox(format("Long ago, Cormoria possessed three great treasures... the Mega Dreamstones. The old tales called them the Legacy of Cormor.\pI confess I understand the why of it less than I would like, but the significance is quite telling."))
    msgbox(format("In any case... one of these stones was shattered at some point in the past. A friend of mine, whose name you are better off not knowing, has learned where its nine pieces came to rest."))
    msgbox(format("There are powerful cults in Cormoria. Two of them want those pieces for reasons I am unsure of, but based on what I have learned in the past decade... they are not planning anything good.\pIf they reach the shards first... I fear neither of us will like what they awaken."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("And the Trials?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Besides serving as a path for you to reveal your identity, and a means to grow into your potential as a Trainer, the Trials are the reason no one will question what a Rainhawk is doing on a mountaintop, and my name never has to come up.\pA Trial challenger can go almost anywhere he pleases."))
    msgbox(format("Your second mission, therefore, is ultimately simple. Bring the pieces to me... and do it quietly, without attracting unneeded attention."))
    msgbox(format("The Trials will make you Champion. The shards will make sure there is still an Empire left for you to rule."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Which means no more announcing yourself to thieves as the youngest Rainhawk in history."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("...She asked."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("I know someone who can make the stone whole again, and keep the cults from taking control of it."))
    msgbox(format("That is also what the PokéLog is for. Every Pokémon you record tells me where you have been and what lives there.\pIf a shard is nearby, the Pokémon there will be affected in various ways. I have quite a few potential leads as well, but you are not yet strong enough to pursue them."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Where do I begin? Surely there must be something I can do, even if I'm currently a novice Trainer."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("West, past Route 11, toward Mirroh. Kimaris Langerin oversees the first Trial there, and there are rumors of a piece on the mountain above it."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("But first, take a day to settle in. See the valley, and get to know your new partner. Learn its habits before someone else tests them for you."))
    hideportrait
    closemessage
    releaseall
    end
}

script PellucaUmbraLab_EventScript_Umbra{
    lock
    faceplayer
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    if (var(VAR_UNUSED_0x40A1) >= 4){
        msgbox(format("Trials for the crown, shards for the Empire. But the valley first, then Mirroh. And do try to get some sleep."))
    } else {
        msgbox(format("Take your time. This is an important choice."))
    }
    hideportrait
    closemessage
    release
    end
}
