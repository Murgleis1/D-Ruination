raw`
    .set LOCALID_DRL_CADMUS,     1
    .set LOCALID_DRL_BALL_FRIG,  2
    .set LOCALID_DRL_BALL_TEDD,  3
    .set LOCALID_DRL_BALL_TINK,  4
    .set LOCALID_DRL_EDEN,       5
    .set LOCALID_DRL_NEPTUNE,    6
    .set LOCALID_DRL_PILFER,     7
`

// ================= DREAMSTONE RUINATION - Chapter 1, Beat 2 & 3 =================
// Lab briefing -> three-starter selection -> Eden's theft and fight -> (monastery cell) ->
// shard briefing back here.
// VAR_UNUSED_0x40A1 = lab stage: 0 fresh, 1 briefed/choosing, 2 theft done (cell scene next),
//                     3 back from the cell (shard briefing), 4 done
// VAR_UNUSED_0x4083 = starter picked (1 Frigibax, 2 Teddiursa, 3 Tinkatink)
// Dialogue pass 2026-11-16 (user-approved direction): Cadmus measured and dry, never states his
// feelings; Osrid a soldier's economy of words; Eden quick and performing carelessness. Show, don't
// tell. Osrid's nameplate: "Prince <name>" in private with Cadmus, "Nomad Alban" when anyone else
// is present. Eden is "Brigand ???" / "Thief" until she gives her name in the cell.

mapscripts PellucaUmbraLab_MapScripts{
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_UNUSED_0x886)
        setflag(FLAG_UNUSED_0x887)
        setflag(FLAG_UNUSED_0x88E)
        // the three balls are already on the table when Osrid walks in (user's briefing:
        // "Those balls behind you...") and stay there until he has chosen
        if (var(VAR_UNUSED_0x40A1) <= 1){
            clearflag(FLAG_UNUSED_0x885)
        } else {
            setflag(FLAG_UNUSED_0x885)
        }
        return
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_UNUSED_0x40A1, 0: DR_Lab_Briefing
        VAR_UNUSED_0x40A1, 3: DR_Lab_ShardBriefing
    ]
}

script DR_Lab_Briefing{
    // Dialogue by the user (2026-11-16), set as written apart from small typo fixes.
    lockall
    setvar(VAR_UNUSED_0x40A1, 1)
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 2))
    waitmovement(0)
    applymovement(LOCALID_DRL_CADMUS, moves(face_down))
    waitmovement(0)
    delay(20)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Welcome home, my Prince. Forgive the chaos.\pThis lab is my personal environment, and a place where we can communicate openly, without reservations."))
    hideportrait
    closemessage
    msgbox(format("Cadmus raises a hand toward your mask."))
    closemessage
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Will you let me see your face?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("...No. I could not bear it. It is a complete ruin."))
    closemessage
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("...I understand. I will not press the matter.\pThe last time you were in Pelluca, you and your sister were ten years old. You fell out of the Academy's apple tree in front of half the faculty. Do you remember?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("I remember the tree."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("How I miss those days."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("But alas, let us speak about the present, and your immediate future.\pTo the Empire, you are Nomad Alban, a Rainhawk discharged honorably due to injury and now formally conscripted under the Ministry of Education.\pThe Academy has also named you its head of security, which mostly means no door in Pelluca Valley will be closed to you... along with most places in the Empire."))
    msgbox(format("There is a dormitory northwest of here with your cover name on the door, the largest study on the first floor. It isn't much, but the door locks and the bed is comfy."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("And the “real” reason I am here?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("It is as you probably guessed. Earn the Trial Badges. All of them.\pA Rainhawk who holds every badge has the right to challenge the Champion. She is someone you know quite well... someone who loves you even more than I do."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("My sister."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Your sister. Rhydia has held the title for five years now, and she rules the Empire in your mother's name besides.\pA man who beats the Champion in front of the whole Empire can tell everyone who he really is, and no one will dare touch him."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Does she know I'm here?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("No, though in time this could change."))
    closemessage
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Let us move on, however. What are Pokémon, to you?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("...Assets. You keep them fed, you keep them sharp, and you use them carefully."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Those sound like Surge's words."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("They kept me alive."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Certainly they did... but they also left you burned to ashes on that beach."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Enough.\pThose balls behind you... are those Starter Pokémon? I thought those were only given to noble children."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Usually. These three are different.\pRead the note beside each one before you choose. I wrote them myself, so forgive the handwriting."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Choose? Me?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Yes, you. Before you choose, however, you must take this.\pYou'll be meeting a great many Pokémon from here on, and you should keep a record of them. I will explain in greater detail later."))
    hideportrait
    closemessage
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("{PLAYER} received the PokéLog!"))
    waitfanfare
    setflag(FLAG_SYS_POKEDEX_GET)
    closemessage
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("The Log is merely paper and ink. It isn't elaborate, but it will serve us well. Write down each one you meet, what it is and how it fights, in your own hand.\pIn the army, someone else wrote the reports and you read them. This time, you see each Pokémon for yourself."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Understood."))
    hideportrait
    closemessage
    releaseall
    end
}

script DR_Lab_BallFrigibax{
    lock
    faceplayer
    showmonpicshiny(SPECIES_FRIGIBAX, 10, 3)
    msgbox(format("Heraldic Frigibax.\pHatched from an egg I found on Mt. Mirroh. Note the coloring. I have never seen another like it.\pIt favors Dragon and Ice moves, though it learns a good deal more if you are patient with it.\pIts final form, Baxcalibur, is so rare that only one other has been recorded on this continent in two hundred years.\pOne old text claims it can grow stronger still with the help of a special stone. I have found nothing to confirm it."))
    hidemonpic
    msgbox(format("Take the Heraldic Frigibax as your partner?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_UNUSED_0x4083, 1)
        givemon(SPECIES_FRIGIBAX, 5, item=ITEM_SITRUS_BERRY, isShiny=TRUE)
        removeobject(LOCALID_DRL_BALL_FRIG)
        closemessage
        goto(DR_Lab_Theft)
    }
    release
    end
}

script DR_Lab_BallTeddiursa{
    lock
    faceplayer
    showmonpic(SPECIES_TEDDIURSA, 10, 3)
    msgbox(format("Bloodmoon Teddiursa.\pThe Blood Moon line has been rumored for over a century. I found this cub by chance a year ago, on a small wooded island far to the east.\pMuch about it is still a mystery. What I have seen suggests a gift for special attacks and a sturdy constitution, and its moves seem to grow along the same lines."))
    hidemonpic
    msgbox(format("Take the Bloodmoon Teddiursa as your partner?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_UNUSED_0x4083, 2)
        givemon(SPECIES_TEDDIURSA, 5, item=ITEM_SITRUS_BERRY)
        removeobject(LOCALID_DRL_BALL_TEDD)
        closemessage
        goto(DR_Lab_Theft)
    }
    release
    end
}

script DR_Lab_BallTinkatink{
    lock
    faceplayer
    showmonpic(SPECIES_TINKATINK, 10, 3)
    msgbox(format("Dragonmaul Tinkatink.\pI came across this egg in the dunes north of Mt. Ceram a few months ago, and I still can't quite believe my luck.\pThe Tinkatink clans of Cormoria's deserts are said to share this coloring, and to learn moves suited to hunting dragons, and even other Fairy types.\pA colleague tells me a Cormorian Tinkaton can grow stronger still with some rare material worked into its gear. I have not been able to confirm it."))
    hidemonpic
    msgbox(format("Take the Dragonmaul Tinkatink as your partner?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1){
        setvar(VAR_UNUSED_0x4083, 3)
        givemon(SPECIES_TINKATINK, 5, item=ITEM_SITRUS_BERRY)
        removeobject(LOCALID_DRL_BALL_TINK)
        closemessage
        goto(DR_Lab_Theft)
    }
    release
    end
}

script DR_Lab_Theft{
    lockall
    additem(ITEM_POTION, 1)
    setvar(VAR_UNUSED_0x40A1, 2)
    setflag(FLAG_SYS_POKEMON_GET)
    delay(20)
    fadeoutbgm(4)
    fadescreen(FADE_TO_BLACK)
    delay(45)
    setobjectxy(OBJ_EVENT_ID_PLAYER, 4, 10)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
    clearflag(FLAG_UNUSED_0x886)
    addobject(LOCALID_DRL_EDEN)
    if (var(VAR_UNUSED_0x4083) == 1){ removeobject(LOCALID_DRL_BALL_TINK) }
    if (var(VAR_UNUSED_0x4083) == 2){ removeobject(LOCALID_DRL_BALL_FRIG) }
    if (var(VAR_UNUSED_0x4083) == 3){ removeobject(LOCALID_DRL_BALL_TEDD) }
    delay(45)
    fadescreen(FADE_FROM_BLACK)
    playbgm(MUS_ENCOUNTER_AQUA, FALSE)
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Who put out the lamps?"))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Don't mind me, gentlemen. I'll only be a moment."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Put that down."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Mm, no. I came a long way for this one."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Neptune."))
    hideportrait
    closemessage
    clearflag(FLAG_UNUSED_0x887)
    addobject(LOCALID_DRL_NEPTUNE)
    playmoncry(SPECIES_JOUSTEEL, CRY_MODE_NORMAL)
    waitmoncry
    delay(16)
    applymovement(LOCALID_DRL_NEPTUNE, moves(walk_down * 2 walk_left * 1 face_up))
    waitmovement(0)
    delay(20)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("So the stories about your Jousteel are true. He's bigger than I was told.\pFine. I'll find another way out."))
    hideportrait
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_fast_left * 1 walk_fast_up * 1 face_left))
    applymovement(LOCALID_DRL_EDEN, moves(face_right))
    waitmovement(0)
    delay(12)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Is that a mending mask? From Athanto? That's worth more than this whole cellar. Who are you supposed to be?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("Nomad Alban")
    msgbox(format("Put it back."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("You'll have to take it off me. Pilfer, up!"))
    hideportrait
    closemessage
    clearflag(FLAG_UNUSED_0x88E)
    addobject(LOCALID_DRL_PILFER)
    applymovement(LOCALID_DRL_PILFER, moves(face_right))
    waitmovement(0)
    playmoncry(SPECIES_NICKIT, CRY_MODE_NORMAL)
    waitmoncry
    delay(20)
    if (var(VAR_UNUSED_0x4083) == 1){ trainerbattle_no_intro(TRAINER_DR_EDEN_LAB_1, DR_Lab_Text_EdenDefeat) }
    if (var(VAR_UNUSED_0x4083) == 2){ trainerbattle_no_intro(TRAINER_DR_EDEN_LAB_2, DR_Lab_Text_EdenDefeat) }
    if (var(VAR_UNUSED_0x4083) == 3){ trainerbattle_no_intro(TRAINER_DR_EDEN_LAB_3, DR_Lab_Text_EdenDefeat) }
    lockall
    delay(20)
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("Who are you?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("Nomad Alban")
    msgbox(format("Nomad Alban."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_NEUTRAL)
    speakername("Thief")
    msgbox(format("Never heard of you."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("Nomad Alban")
    msgbox(format("Good."))
    showportrait(PORTRAIT_EDEN, PORTRAIT_EXPR_POSITIVE)
    speakername("Thief")
    msgbox(format("Ha! All right, Nomad Alban. I want a rematch, the minute I get out of whatever hole they're about to put me in."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("You'll find it a very deep hole."))
    hideportrait
    closemessage
    playmoncry(SPECIES_JOUSTEEL, CRY_MODE_NORMAL)
    waitmoncry
    delay(30)
    fadescreen(FADE_TO_BLACK)
    setflag(FLAG_UNUSED_0x885)
    setflag(FLAG_UNUSED_0x886)
    setflag(FLAG_UNUSED_0x887)
    setflag(FLAG_UNUSED_0x88E)
    warp(MAP_PELLUCA_TEMPLAR_MONASTERY, 6, 6)
    waitstate
    releaseall
    end
}

text DR_Lab_Text_EdenDefeat{
    format("Five minutes with that Pokémon and you fight like you've had it for years. Who taught you that?")
}

// Back from the monastery cell (stage 3): Umbra's shard briefing. Per the bible (Sec. 6) it
// waits for the theft: someone sent her, which raises the stakes. Cadmus speaks at his own
// level of knowledge (the operational plan, not the deep cosmology) and does not name his source.
script DR_Lab_ShardBriefing{
    lockall
    setvar(VAR_UNUSED_0x40A1, 4)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    applymovement(LOCALID_DRL_CADMUS, moves(face_down))
    waitmovement(0)
    delay(20)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("She knew where to look, and she knew exactly what to take. Someone told her both."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Someone who knew I was coming."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Or someone who knew I was preparing for someone. Either way, I can't put off telling you about the other half of your work."))
    msgbox(format("Cormoria once had a Mega-Dreamstone. The old tales call it the heart of the Empire. I understand it less than I would like, but I am certain it matters.\pIt was shattered long ago. A friend of mine, whose name you don't need, has found where nine of the pieces came to rest."))
    msgbox(format("There are cults in Cormoria, more of them every year, and two of them want those pieces as badly as I do. If they reach them first, I don't think either of us will like what they wake up."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("And the badges?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("The badges are why no one will ask what you are doing on a mountain. A Rainhawk chasing Trials can go anywhere he likes.\pBring the pieces to me. I know someone who can make the stone whole again."))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Where do I start?"))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("West, past Route 11, toward Mirroh. Kimaris Langerin oversees the first Trial there, and there are rumors of a piece on the mountain above it.\pBut take a day in the valley first. Learn your partner's habits before someone tests them for you."))
    hideportrait
    closemessage
    releaseall
    end
}

script PellucaUmbraLab_EventScript_Umbra{
    lock
    faceplayer
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    if (var(VAR_UNUSED_0x40A1) >= 4){
        msgbox(format("The valley first, then Mirroh. And sleep, if you can manage it."))
    } else {
        msgbox(format("Take your time. They have waited this long."))
    }
    hideportrait
    closemessage
    release
    end
}
