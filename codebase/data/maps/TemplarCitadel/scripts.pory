mapscripts TemplarCitadel_MapScripts {}

script TemplarCitadel_EventScript_ToRoute13_18 {
    setvar(VAR_TEMP_1, 1)          # (else the trigger fires again every frame of the fade)
    warp(MAP_ROUTE13, 32, 1)
}

