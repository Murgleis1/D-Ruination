    setmetatile(6, 5, 0x24E, FALSE)
    setmetatile(7, 1, 0x205, TRUE)
    setmetatile(7, 2, 0x244, TRUE)
    setmetatile(7, 3, 0x247, TRUE)
    setmetatile(7, 4, 0x24A, TRUE)
    setmetatile(7, 5, 0x24F, TRUE)
