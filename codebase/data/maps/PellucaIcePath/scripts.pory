    setmetatile(8, 4, 0x24B, TRUE)
    setmetatile(8, 5, 0x250, TRUE)
    setmetatile(8, 6, 0x254, FALSE)
    setmetatile(9, 1, 0x207, TRUE)
    setmetatile(9, 2, 0x246, TRUE)
