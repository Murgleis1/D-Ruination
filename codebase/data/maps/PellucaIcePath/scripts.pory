    setmetatile(9, 4, 0x24C, TRUE)
    setmetatile(9, 5, 0x251, TRUE)
    setmetatile(9, 6, 0x255, FALSE)
    setmetatile(10, 3, 0x20B, FALSE)
    setmetatile(10, 4, 0x24D, FALSE)
    setmetatile(10, 5, 0x252, FALSE)
    return
}

