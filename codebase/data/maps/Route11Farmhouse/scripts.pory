mapscripts Route11Farmhouse_MapScripts {}

script DR_R11_FarmWife {
    lock
    faceplayer
    if (flag(FLAG_DR_R11_THEFT_SEEN)) {
        msgbox(format("We bar the shutters when the fog comes off Hollow Hill. Some nights you can hear marching in it."))
    } else {
        msgbox(format("A Templar lass stopped for water at dawn. She carried a little bird, black on one side and white on the other."))
    }
    release
    end
}

script DR_R11_FarmDaughter {
    msgbox(format("Mama says the Templars have a big cathedral up in the mountains somewhere. I would love to see it someday!"), MSGBOX_NPC)
    end
}
