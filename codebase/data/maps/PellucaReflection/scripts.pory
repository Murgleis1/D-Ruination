// ============ DREAMSTONE RUINATION - Chapter 1, Beat 1: the cold open ============
// Osrid alone above dark water; Cadmus's letter; the signed reply (diegetic naming).
// Dialogue pass 2026-11-16: the letter is written the way a careful man writes when he
// expects it to be read by the wrong people. It never names the prince, and it tells the
// player three things without stating them: the mask is not customary, it covers burns, and
// the burns are Boran Surge's doing.

mapscripts PellucaReflection_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: PellucaReflection_Cutscene
    ]
}

script PellucaReflection_Cutscene {
    lockall
    setvar(VAR_TEMP_1, 1)
    special(DrSetPlayerOsridSprite)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(0)
    delay(40)
    msgbox(format("A sealed letter. Plain wax, no crest."), MSGBOX_SIGN)
    // The letter and the reply read on parchment, in MonoMyth's blackletter (user 2026-11-23)
    special(DrParchmentOn)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Nomad Alban,\pThe surgeon's report from Sevii reached my desk a week before your commander's did. A commander proud of his decisions does not take a week to report them.\pBurns to the face and neck, taken holding a beach that needed twice the men. Commander Surge split his forces across two fronts, and you paid for his folly."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("The Commander has since been invited to explain his judgement to people who outrank us both. He will be explaining it for some time, from a cell that has never seen daylight."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("I am told the army gave you a rare mending mask from the Athanto kingdom while your burns heal. Such masks hasten healing and ward off evil. None have been made since the kingdom fell, and one is now worth more than most noble estates, so expect a few stares.\pWear it well. I suspect it will serve you longer than the burns require.\pI am pleased to inform you that, for your actions on that beach and in light of your injuries, you have been granted an honorable discharge from further military service, with lifetime benefits.\pYou have also been raised to the rank of Rainhawk. At twenty, you are the youngest in Cormorian history to hold it. The rank carries the right to challenge the Trials, should you choose to, a right the Empire rarely extends beyond its noble houses. I suspect you will choose to.\pAs of the day this letter reaches you, you will serve under me in the Ministry of Education."))
    msgbox(format("Your immediate orders are as follows. The Pale Veluza waits in the harbor south of your barracks. You are to board her and return home. She sails for Pelluca Valley, where I will meet you at the docks.\pWrite your reply and leave it with the Templar chaplain at your barracks. It will reach me quickly. Sign it with the name you were born with, not the one I gave you a decade ago, and I will know it is truly you."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Then burn this. These days, too many people in Cormoria read letters never meant for them.\pC."))
    hideportrait
    closemessage
    special(DrDoPlayerNaming)
    waitstate
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    msgbox(format("Received and acknowledged. I will be aboard the Veluza when she sails.\pIt... will be good to be home again."))
    hideportrait
    closemessage
    special(DrParchmentOff)
    // "Then burn this.": the letter goes into the lamp (sound, no narration)
    delay(30)
    playse(SE_M_EMBER)
    waitse
    delay(40)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_UNUSED_0x404E, 1)
    warp(MAP_PELLUCA_HARBOUR, 40, 21)
    waitstate
    releaseall
    end
}
