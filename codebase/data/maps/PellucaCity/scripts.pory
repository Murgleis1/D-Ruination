// DR: the west gate (tools/art/route11/build_route11.py). Leaving the Valley for Route 11 is stopped until the story
// sends Osrid west (bible 20). For now the way opens once the shrine under the church is awakened; stage 4 (the
// main story) puts the real condition here.
// (its triggers span all five rows of the west opening, 28-32: rows 31-32, the grass under the road, were open past
// them until 2026-11-25)
script PellucaCity_EventScript_DrWestGate {
    if (flag(FLAG_DR_STATUE_AWAKENED)) {
        setvar(VAR_TEMP_1, 1)
        end
    }
    lockall
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    special(DrSetPrinceNameplate)
    if (flag(FLAG_DR_CHURCH_BLASTED)) {
        msgbox(format("Cadmus told me to meet him at the church.\pI shouldn't leave the Valley yet."))
    } else {
        msgbox(format("I still have things to take care of here in the Valley.\pI shouldn't leave just yet."))
    }
    hideportrait
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, PellucaCity_Movement_DrWestGateBack)
    waitmovement(0)
    releaseall
}

movement PellucaCity_Movement_DrWestGateBack {
    walk_right
}

// ============ Pelluca's later-chapter exits, closed for Chapter 1 (user 2026-11-22) ============
// The north road (to the Ivy River) and the east road (to Hoya Delta) lead to later chapters. A Templar guard stands
// in each road; a line of triggers spans the rest of the opening (the north gap is six cells wide, x 36-41, row 3;
// the east one five, rows 24-28 at x 74, the top row being the walk behind the treetops) and turns the player back.
// Their own variable (VAR_TEMP_2): the west gate's VAR_TEMP_1 is set once the shrine is awakened, which would switch
// these off with it. Lift them when those chapters open.
script PellucaCity_EventScript_RoadGuardNorth {
    msgbox(format("Halt. The road north to the Ivy River is closed by order of the Templar Order."), MSGBOX_NPC)
    end
}

script PellucaCity_EventScript_RoadClosedNorth {
    lockall
    msgbox(format("Halt. The road north to the Ivy River is closed by order of the Templar Order. Turn back."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
    waitmovement(0)
    releaseall
}

script PellucaCity_EventScript_RoadGuardEast {
    msgbox(format("Halt. The road east to Hoya Delta is closed by order of the Templar Order."), MSGBOX_NPC)
    end
}

script PellucaCity_EventScript_RoadClosedEast {
    lockall
    msgbox(format("Halt. The road east to Hoya Delta is closed by order of the Templar Order. Turn back."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_left))
    waitmovement(0)
    releaseall
}


// ================= The Fisherman's Dilemma (Pelluca sidequest; user-approved 2026-11-27) =================
// The fisherman on the great pier (PellucaHarbour) lost his catch to a Wimpod that fled up into town looking for fresh
// water. It hides at the plaza fountain, then the well by the north-west house, then the pond's south bank, where it
// turns to fight: the shiny-tease question, then a Lv.12 Wimpod (Aqua Jet / Bug Bite / Trailblaze; its hidden-ability
// slot, so its Golisopod has Tough Claws). Caught or defeated, the fisherman gives the Old Rod.
const LOCALID_DR_WIMPOD_FOUNTAIN = 14
const LOCALID_DR_WIMPOD_WELL = 15
const LOCALID_DR_WIMPOD_POND = 16

// each Wimpod shows only at its own step of the quest
script PellucaCity_EventScript_WimpodFlags {
    setflag(FLAG_DR_HIDE_WIMPOD_FOUNTAIN)
    setflag(FLAG_DR_HIDE_WIMPOD_WELL)
    setflag(FLAG_DR_HIDE_WIMPOD_POND)
    if (flag(FLAG_DR_WIMPOD_DONE) || !flag(FLAG_DR_WIMPOD_QUEST_STARTED)) {
        return
    }
    if (flag(FLAG_DR_WIMPOD_LEFT_WELL)) {
        clearflag(FLAG_DR_HIDE_WIMPOD_POND)
    } elif (flag(FLAG_DR_WIMPOD_LEFT_FOUNTAIN)) {
        clearflag(FLAG_DR_HIDE_WIMPOD_WELL)
    } else {
        clearflag(FLAG_DR_HIDE_WIMPOD_FOUNTAIN)
    }
    return
}

script PellucaCity_EventScript_WimpodFountain {
    lock
    playmoncry(SPECIES_WIMPOD, CRY_MODE_NORMAL)
    applymovement(LOCALID_DR_WIMPOD_FOUNTAIN, moves(emote_exclamation_mark))
    waitmovement(0)
    msgbox(format("Something is splashing in the fountain! A grey shell darts out and skitters away west."))
    closemessage
    applymovement(LOCALID_DR_WIMPOD_FOUNTAIN, moves(walk_fast_left * 4))
    waitmovement(0)
    removeobject(LOCALID_DR_WIMPOD_FOUNTAIN)
    setflag(FLAG_DR_HIDE_WIMPOD_FOUNTAIN)
    setflag(FLAG_DR_WIMPOD_LEFT_FOUNTAIN)
    clearflag(FLAG_DR_HIDE_WIMPOD_WELL)
    addobject(LOCALID_DR_WIMPOD_WELL)
    release
    end
}

script PellucaCity_EventScript_WimpodWell {
    lock
    playmoncry(SPECIES_WIMPOD, CRY_MODE_NORMAL)
    applymovement(LOCALID_DR_WIMPOD_WELL, moves(emote_exclamation_mark))
    waitmovement(0)
    msgbox(format("A clatter in the well bucket! The creature bolts north toward the pond."))
    closemessage
    applymovement(LOCALID_DR_WIMPOD_WELL, moves(walk_fast_up * 3))
    waitmovement(0)
    removeobject(LOCALID_DR_WIMPOD_WELL)
    setflag(FLAG_DR_HIDE_WIMPOD_WELL)
    setflag(FLAG_DR_WIMPOD_LEFT_WELL)
    clearflag(FLAG_DR_HIDE_WIMPOD_POND)
    addobject(LOCALID_DR_WIMPOD_POND)
    release
    end
}

script PellucaCity_EventScript_WimpodPond {
    lock
    msgbox(format("The creature has its back to the water. It turns to fight!"))
    closemessage
    playmoncry(SPECIES_WIMPOD, CRY_MODE_ENCOUNTER)
    waitmoncry
    call(DrShinyTease_Ask)
    setwildbattle(SPECIES_WIMPOD, 12)
    createmon(1, 0, SPECIES_WIMPOD, 12, abilityNum=2, move1=MOVE_AQUA_JET, move2=MOVE_BUG_BITE, move3=MOVE_TRAILBLAZE, move4=MOVE_NONE)
    dowildbattle
    clearflag(FLAG_FORCE_SHINY)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if (var(VAR_RESULT) == B_OUTCOME_WON || var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
        removeobject(LOCALID_DR_WIMPOD_POND)
        setflag(FLAG_DR_HIDE_WIMPOD_POND)
        setflag(FLAG_DR_WIMPOD_DONE)
    }
    release
    end
}
