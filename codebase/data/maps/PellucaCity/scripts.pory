    end
}


// ============ DREAMSTONE RUINATION - Chapter 1 arrival ============
// Osrid disembarks the Pale Veluza at the Pelluca dock; Cadmus greets and leads him to the lab.
script DR_PellucaCity_Arrival{
    lockall
    setvar(VAR_UNUSED_0x404E, 2)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement(0)
    delay(20)
    // Dialogue pass 2026-11-16: dockhands talk as he passes (the mask is not normal; Sevii
    // burned him). Cadmus greets him in public under the cover name and keeps the rest for
    // the lab.
    speakername("Dockhand")
    msgbox(format("A Rainhawk, in a mask? Like something out of the old stories."))
    speakername("Sailor")
    msgbox(format("That's the one who held the beach at Sevii. Burned for it, they say."))
    closemessage
    delay(30)
    applymovement(LOCALID_DR_CADMUS, moves(walk_down * 5))
    waitmovement(0)
    delay(12)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_SMILE)
    msgbox(format("Rainhawk Alban. Welcome to Pelluca Valley."))
    closemessage
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("And the burns? Are they healing?"))
    showportrait(PORTRAIT_OSRID, PORTRAIT_EXPR_NEUTRAL)
    speakername("“Nomad”")
    msgbox(format("Slowly. The mask helps."))
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Good. Walk with me. We will talk somewhere quieter."))
    hideportrait
    closemessage
    release
    delay(12)
    // The walk to the lab passes the shrine to the lost prince (user-approved 2026-11-16).
    // Cadmus walks on to the lab door; Osrid stops in front of the shrine. Nobody speaks to it.
    applymovement(LOCALID_DR_CADMUS, moves(walk_up * 6 walk_right * 3 face_left))
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 6 walk_left walk_up face_up))
    waitmovement(0)
    waitmovement(LOCALID_DR_CADMUS)
    delay(30)
    msgbox(format("For Prince {PLAYER}, Keerin's Chosen. Wherever you are, come home."), MSGBOX_SIGN)
    closemessage
    delay(40)
    showportrait(PORTRAIT_CADMUS, PORTRAIT_EXPR_NEUTRAL)
    msgbox(format("Rainhawk."))
    hideportrait
    closemessage
    applymovement(LOCALID_DR_CADMUS, moves(face_up))
    waitmovement(0)
    delay(12)
    playse(SE_EXIT)
    removeobject(LOCALID_DR_CADMUS)
    delay(16)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right walk_right * 4 face_up))
    waitmovement(0)
    delay(12)
    setflag(FLAG_UNUSED_0x884)
    warp(MAP_PELLUCA_UMBRA_LAB, 0)
    waitstate
    end
}


// ================= Pelluca Valley, empire era (events pass 2026-11-16) =================
script DR_PellucaCity_Shrine{
    lock
    msgbox(format("For Prince {PLAYER}, Keerin's Chosen. Wherever you are, come home."), MSGBOX_SIGN)
    release
    end
}

script DR_PellucaCity_ShrineKeeper{
    lock
    faceplayer
    msgbox(format("The night the twins were born, Keerin was seen over Silversun Palace. She chose the boy, they said. First time in generations."))
    msgbox(format("Ten years now, and not one word of him. Most folk have stopped coming."))
    msgbox(format("Not the Regent-Queen, though. Her candles arrive every spring, right on time."))
    closemessage
    applymovement(LOCALID_DR_SHRINE_KEEPER, moves(face_up))
    waitmovement(0)
    release
    end
}

script DR_PellucaCity_SignWest{
