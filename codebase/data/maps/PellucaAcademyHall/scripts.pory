// ============ DREAMSTONE RUINATION - Pelluca Valley: the Academy main hall ============
// MonoMyth's Ironbark Cabin cleaned up into the Academy's galleried hall (user design 2026-11-19): three floors
// joined by stairs, reception desk, notice board; the top gallery still under construction.
// The Academy is unfinished: labourers are hard to get out from Silversun (according to Cadmus). Open rooms will
// be Cadmus's office (G1), the library (M1), an active classroom (M3) and the haunted teachers' lounge (T4,
// rusted key after the second badge); they are designed next, so every door is closed in this build.
// Built by tools/art/academy/build_hall.py. All lines are placeholders for the dialogue pass.

mapscripts PellucaAcademyHall_MapScripts {}

script DR_Academy_OfficeDoor {
    msgbox(format("A brass plate on the door reads: CADMUS UMBRA, VIZIER OF EDUCATION.\pIt's closed."), MSGBOX_SIGN)
    end
}

script DR_Academy_LibraryDoor {
    msgbox(format("A sign on the door reads: LIBRARY.\pIt's closed."), MSGBOX_SIGN)
    end
}

script DR_Academy_ClassroomDoor {
    msgbox(format("A lesson is going on inside. Better not interrupt."), MSGBOX_SIGN)
    end
}

script DR_Academy_LoungeDoor {
    msgbox(format("The door is locked. Its keyhole is crusted with rust."), MSGBOX_SIGN)
    end
}

script DR_Academy_RenovationDoor {
    msgbox(format("A notice is nailed to the door: CLOSED FOR RENOVATION."), MSGBOX_SIGN)
    end
}

script DR_Academy_NoticeBoard {
    msgbox(format("Notices are pinned to the board.\pLABOURERS WANTED: masons and carpenters for work on the Academy. Room and board provided. Apply to the Ministry of Education."), MSGBOX_SIGN)
    end
}
