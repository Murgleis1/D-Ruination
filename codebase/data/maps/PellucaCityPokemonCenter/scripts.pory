// ============ DREAMSTONE RUINATION - Pelluca Valley: the Seaside Tavern ============
// This map id (MAP_PELLUCA_CITY_POKEMON_CENTER) is reused for the tavern so the town's warp 2
// and the Pelluca respawn keep working. Layout: MonoMyth's Fort Elderflower tavern
// (LAYOUT_PELLUCA_TAVERN), warm wood palette. Staff (shared scripts in data/scripts/dr_tavern.pory):
// innkeeper heals with food and drink, barkeep sells (stock below), the Sage offers names, moves,
// natures and later Apex Fruits, the Caretaker keeps stored Pokemon. Regulars: the sailor and fisherman.

mapscripts PellucaCityPokemonCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setrespawn(HEAL_LOCATION_PELLUCA_CITY)
    }
}

script DR_Tavern_Barkeep {
    lock
    faceplayer
    message(format("Provisions for the road? Have a look."))
    waitmessage
    pokemart(DR_Tavern_Stock)
    msgbox(format("Safe roads. Aye, the prices rose again.\pEvery ball and tonic on that shelf comes through Sylphon & Stone, and their factor wants his coin before the crates are opened."))
    closemessage
    release
    end
}

// Pelluca's Caretaker: the shared service, then the harbour's gossip (bible 16.15).
script DR_PellucaTavern_Caretaker {
    lock
    faceplayer
    msgbox(format("I tend the Pokémon a traveller can't carry on the road. Shall I fetch yours?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        closemessage
        special(ShowPokemonStorageSystemPC)
        waitstate
    }
    msgbox(format("They're in good hands. Half the beasts I board belong to sailors who won't sail east, with Paldea's lords at each other's throats and Kalos little better."))
    closemessage
    release
    end
}

mart DR_Tavern_Stock {
    ITEM_POTION
    ITEM_POKE_BALL
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_BURN_HEAL
    ITEM_AWAKENING
}

script DR_Tavern_Sailor {
    lock
    faceplayer
    msgbox(format("Two ships in this week, and one came round by Sevii. Kanto's bird-priests have taken the old chapel of Arceus for their own, her crew say.\pAnd still the skirmishes off Johto, for all the talk of peace. But you'd know more of that than I, Rainhawk."))
    closemessage
    release
    end
}

script DR_Tavern_Fisherman {
    lock
    faceplayer
    msgbox(format("Something's breeding in the water by the sealed cave.\pMy nets come up in ribbons, and every time there's Crawdaunt in them. More than I've ever seen in one place."))
    closemessage
    release
    end
}

// Kept: Dreamstone Mysteries scripts still referenced by MirrohBaseCamp_PokemonCenter.
script PellucaCity_PokemonCenter_Nurse1{
	msgbox(format("We've had enough of the Heal Pass system. We're unionising!"), MSGBOX_NPC)
	end
}

script PellucaCity_PokemonCenter_Nurse2{
	msgbox(format("Down with Heal Passes! Or at least station us in decent spots!"), MSGBOX_NPC)
	end
}

script PellucaCity_PokemonCenter_Nurse3{
	msgbox(format("We've all got it bad, but the worst is the nurse up in Winterlily Hollow!\pI'm going up there with these Chanseys to help her out."), MSGBOX_NPC)
	end
}

script PellucaCity_PokemonCenter_Nurse4{
	msgbox(format("The nurse in Winterlily Hollow requested for some extra help. Since the higher-ups don't care, we're going to look out for our sisters!"), MSGBOX_NPC)
	end
}

script PellucaCity_PokemonCenter_Chansey{
	playmoncry(SPECIES_CHANSEY, CRY_MODE_NORMAL)
	msgbox(format("Seeyyy!!\pChansey wants to unionise too!"), MSGBOX_NPC)
	end
}
